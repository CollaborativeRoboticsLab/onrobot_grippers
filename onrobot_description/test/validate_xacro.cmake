foreach(REQUIRED_VARIABLE IN ITEMS
    XACRO_EXECUTABLE
    CHECK_URDF_EXECUTABLE
    MODEL_FILE
    OUTPUT_FILE)
  if(NOT DEFINED ${REQUIRED_VARIABLE})
    message(FATAL_ERROR "${REQUIRED_VARIABLE} is required")
  endif()
endforeach()

execute_process(
  COMMAND "${XACRO_EXECUTABLE}" "${MODEL_FILE}"
  OUTPUT_FILE "${OUTPUT_FILE}"
  RESULT_VARIABLE XACRO_RESULT
  ERROR_VARIABLE XACRO_ERROR
)
if(NOT XACRO_RESULT EQUAL 0)
  message(FATAL_ERROR "Xacro failed for ${MODEL_FILE}: ${XACRO_ERROR}")
endif()

execute_process(
  COMMAND "${CHECK_URDF_EXECUTABLE}" "${OUTPUT_FILE}"
  RESULT_VARIABLE URDF_RESULT
  OUTPUT_VARIABLE URDF_OUTPUT
  ERROR_VARIABLE URDF_ERROR
)
if(NOT URDF_RESULT EQUAL 0)
  message(FATAL_ERROR "URDF validation failed for ${MODEL_FILE}: ${URDF_ERROR}")
endif()

message(STATUS "${URDF_OUTPUT}")