<?xml version="1.0"?>
<package format="3">
  <name>onrobot_control</name>
  <version>0.1.0</version>
  <description>Read-only Modbus TCP transport and ROS 2 node for OnRobot grippers</description>
  <maintainer email="kalanaratnayake95@gmail.com">Kalana Ratnayake</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <build_depend>pkg-config</build_depend>
  <depend>libmodbus-dev</depend>
  <depend>rclcpp</depend>
  <depend>rcl_interfaces</depend>
  <depend>onrobot_msgs</depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <test_depend>rclpy</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>